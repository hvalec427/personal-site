{
  "outputDirectory": "build",
  "buildCommand": "yarn build",
  "installCommand": "yarn install",
  "redirects": [
    {
      "source": "/:path(.+).html",
      "destination": "/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/:path*.html"
    }
  ]
}
