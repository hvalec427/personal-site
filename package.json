{
  "name": "personal-site",
  "version": "4.0.0",
  "type": "module",
  "description": "Static personal website",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.js",
    "build:static": "rm -rf dist && mkdir -p dist && cp -R src/. dist/ && cp -R public/. dist/ && node scripts/build-content.js && node scripts/write-deploy-time.js && node scripts/write-api-config.js",
    "dev": "concurrently \"nodemon --watch src --watch partials -e html,css,js,md --exec 'yarn build'\" \"serve dist\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "husky",
    "secrets": "doppler secrets download --no-file --format env > .env"
  },
  "devDependencies": {
    "@dopplerhq/node-sdk": "^1.3.0",
    "@eslint/js": "9.0.0",
    "concurrently": "9.2.1",
    "eslint": "9.0.0",
    "eslint-config-prettier": "9.0.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "nodemon": "3.1.14",
    "prettier": "3.0.0",
    "serve": "14.2.6"
  },
  "lint-staged": {
    "*.{html,css,md}": [
      "prettier --write"
    ],
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
