{
  "name": "personal-site",
  "version": "1.0.0",
  "type": "module",
  "description": "Personal portfolio website",
  "scripts": {
    "build": "yarn build:blog",
    "build:blog": "node scripts/build-blog.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "9.0.0",
    "eslint": "9.0.0",
    "eslint-config-prettier": "9.0.0",
    "fast-glob": "3.3.0",
    "gray-matter": "4.0.3",
    "husky": "9.1.7",
    "lint-staged": "15.0.0",
    "marked": "12.0.0",
    "prettier": "3.0.0"
  },
  "lint-staged": {
    "*.{html,css,md}": [
      "prettier --write"
    ],
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
