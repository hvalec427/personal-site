{
  "name": "personal-site",
  "version": "4.0.0",
  "type": "module",
  "description": "Static personal website",
  "license": "MIT",
  "scripts": {
    "build": "rm -rf dist && mkdir -p dist && cp -R *.html logs assets robots.txt sitemap.xml dist/",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "9.0.0",
    "eslint": "9.0.0",
    "eslint-config-prettier": "9.0.0",
    "husky": "9.1.7",
    "lint-staged": "15.0.0",
    "prettier": "3.0.0"
  },
  "lint-staged": {
    "*.{html,css,md}": [
      "yarn format:fix"
    ],
    "*.js": [
      "yarn lint:fix",
      "yarn format:fix"
    ]
  }
}
