{
  "name": "personal-site",
  "version": "4.0.0",
  "type": "module",
  "description": "Personal portfolio website built with Jekyll",
  "license": "MIT",
  "scripts": {
    "serve": "bundle exec jekyll serve",
    "build:full": "rm -rf _site && bundle install && yarn gallery:process && bundle exec jekyll build",
    "build": "bundle install && yarn gallery:process && bundle exec jekyll build",
    "gallery:process": "node scripts/processing-gallery-items.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "9.0.0",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "eslint": "9.0.0",
    "eslint-config-prettier": "9.0.0",
    "exiftool-vendored": "26.2.0",
    "fluent-ffmpeg": "2.1.2",
    "husky": "9.1.7",
    "js-yaml": "4.1.0",
    "lint-staged": "15.0.0",
    "prettier": "3.0.0",
    "sharp": "0.33.5"
  },
  "lint-staged": {
    "*.{html,css,md}": [
      "prettier --write",
      "git add"
    ],
    "*.js": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ]
  }
}
