{
  "name": "personal-site",
  "version": "4.0.0",
  "type": "module",
  "description": "Personal portfolio website built with Jekyll",
  "license": "MIT",
  "scripts": {
    "serve": "bundle exec jekyll serve",
    "build": "bundle install && bundle exec jekyll build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "9.0.0",
    "eslint": "9.0.0",
    "eslint-config-prettier": "9.0.0",
    "husky": "9.1.7",
    "lint-staged": "15.0.0",
    "prettier": "3.0.0"
  },
  "lint-staged": {
    "*.{html,css,md}": [
      "prettier --write",
      "git add"
    ],
    "*.js": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ]
  }
}
