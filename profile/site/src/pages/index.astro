---
// /profile now lives at commonplace — send old links there. The profile build
// is identical for dev and prod, so the target is picked from the hostname at
// runtime; the meta refresh is the no-JS fallback (production).
const target = "https://commonplace.hvalec.com/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <script is:inline>
      (function () {
        var host = location.hostname;
        var target =
          host === "localhost" || host === "127.0.0.1"
            ? "http://localhost:5173/"
            : "https://commonplace.hvalec.com/";
        location.replace(target);
      })();
    </script>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Hvalec</title>
  </head>
  <body>
    <a href={target}>commonplace.hvalec.com</a>
  </body>
</html>
