# Copy to ~/.config/hvalec-pc-status.env (chmod 600) and fill in.
# Not read by the server — this only configures pc-status.sh on the Mac
# that's pushing status.

# Base URL of the deployed hvalec-api instance (no trailing slash needed).
PC_STATUS_URL=https://api.hvalec.com

# A per-device token generated from /admin (Devices -> New Device -> pick a
# name and work/personal category). It's only ever shown once at creation
# time, so copy it here right away; if you lose it, revoke the device and
# generate a new one.
PC_STATUS_TOKEN=
